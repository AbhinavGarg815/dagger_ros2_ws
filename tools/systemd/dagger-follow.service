[Unit]
Description=Dagger T4: person + marker following and its page (:8080)
PartOf=dagger.target
After=network-online.target dagger-clock.service dagger-nav.service
Wants=network-online.target dagger-clock.service

[Service]
Type=simple
User=nvidia
Group=dagger
ExecStart=/home/jetson/ros2_ws/tools/systemd/dagger-ros-env.sh ros2 launch dagger_bringup follow.launch.py det_conf:=0.2 marker_dictionary:=DICT_6X6_50 marker_ids:=0 marker_size:=0.175
Restart=on-failure
RestartSec=3
# ros2 launch shuts its nodes down on SIGINT; only it gets the signal (mixed),
# anything left after the timeout is killed
KillSignal=SIGINT
KillMode=mixed
TimeoutStopSec=20

[Install]
WantedBy=dagger.target
