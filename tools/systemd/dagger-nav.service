[Unit]
Description=Dagger T2: odometry, GPS map frame, Nav2, collision monitor, command path
PartOf=dagger.target
After=network-online.target dagger-clock.service dagger-drive.service
Wants=network-online.target dagger-clock.service

[Service]
Type=simple
User=nvidia
Group=dagger
ExecStart=/home/jetson/ros2_ws/tools/systemd/dagger-ros-env.sh ros2 launch dagger_bringup nav2_gps.launch.py
Restart=on-failure
RestartSec=3
# ros2 launch shuts its nodes down on SIGINT; only it gets the signal (mixed),
# anything left after the timeout is killed
KillSignal=SIGINT
KillMode=mixed
TimeoutStopSec=20

[Install]
WantedBy=dagger.target
